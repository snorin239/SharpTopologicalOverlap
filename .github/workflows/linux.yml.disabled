# Deferred until the formalization is complete. Restore the .yml extension to enable.
name: Linux build

on:
  push:
    branches: [master]
  pull_request:
    branches: [master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
      - uses: actions/checkout@v4

      - name: Verify fresh checkout
        run: |
          test ! -e .lake
          test -z "$(git status --porcelain)"

      - name: Set up Lean and fetch the mathlib cache
        uses: leanprover/lean-action@v1
        with:
          auto-config: false
          build: false
          use-mathlib-cache: true
          use-github-cache: false

      - name: Build formalization with TauCeti
        env:
          LAKE_CONFIG: ${{ github.workspace }}/lake-cache.toml
        run: |
          lake cache get --package=TauCeti --service=tauceti-public --repo=TauCetiProject/TauCeti --mappings-only
          lake build

      - name: Verify repository remains clean
        run: |
          lean --version
          lake --version
          test -z "$(git status --porcelain)"
